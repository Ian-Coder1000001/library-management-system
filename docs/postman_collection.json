{
  "info": {
    "name": "Library Management System API",
    "description": "Run 'Login (librarian)' first. It saves the token, and the other requests use it automatically. Login is limited to 5 attempts per minute.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (new patron)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newpatron@example.com\",\n  \"name\": \"New Patron\",\n  \"password\": \"Patron123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (librarian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"Librarian123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "  pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (patron)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"password\": \"Patron123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) {",
                  "  pm.collectionVariables.set('token', data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Get all genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get one genre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres",
                "1"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create genre (librarian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Poetry\",\n  \"slug\": \"poetry\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update genre (librarian)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/genres/6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres",
                "6"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Poems\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete genre (librarian)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/6",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "genres",
                "6"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get all books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get books (filter + search + paging)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genreId=2&search=dune&page=1&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "genreId",
                  "value": "2"
                },
                {
                  "key": "search",
                  "value": "dune"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Get one book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "1"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create book (librarian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Book\",\n  \"author\": \"Test Author\",\n  \"isbn\": \"9781000000099\",\n  \"totalCopies\": 2,\n  \"genreId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update book (librarian)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "20"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Book (2nd edition)\",\n  \"totalCopies\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete book (librarian)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books",
                "20"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get my profile (needs token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "profile"
              ]
            }
          }
        }
      ]
    }
  ]
}